{
  "name": "hapits-postgrestarter",
  "version": "2.0.0",
  "description": "Production-ready Hapi.js TypeScript PostgreSQL starter kit with MikroORM",
  "main": "dist/index.js",
  "author": "Akhshy Ganesh",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node -r module-alias/register dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "prepare": "husky install",
    "mikro:create-migration": "mikro-orm migration:create",
    "mikro:migrate": "mikro-orm migration:up",
    "mikro:revert": "mikro-orm migration:down",
    "mikro:pending": "mikro-orm migration:pending"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@hapi/hapi": "^21.3.2",
    "@hapi/joi": "^17.1.1",
    "@mikro-orm/cli": "^5.9.4",
    "@mikro-orm/core": "^5.9.4",
    "@mikro-orm/migrations": "^5.9.4",
    "@mikro-orm/postgresql": "^5.9.4",
    "@mikro-orm/reflection": "^5.9.8",
    "@mikro-orm/seeder": "^5.9.4",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.3.1",
    "hapi-auth-jwt2": "^10.4.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "pg": "^8.11.3",
    "uuid": "^11.1.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.1",
    "@types/hapi__hapi": "^21.0.0",
    "@types/hapi__joi": "^17.1.11",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.4",
    "@types/node": "^20.17.30",
    "@types/pg": "^8.10.9",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.0.2",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.7",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "_moduleAliases": {
    "@": "dist"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./src/config/mikro-orm.config.ts",
      "./dist/config/mikro-orm.config.js"
    ]
  }
}
